      "code": "H1Missing",
      "category": "SEO",
      "level": "Warning",
      "heading": "The page has no <h1> heading.",
      "description": "The main heading tells users and search engines what the page is about.",
      "recommendation": "Add one <h1> that summarizes the page's topic.",
      "position": null
    },
    {
      "code": "CanonicalMissing",
      "category": "SEO",
      "level": "Warning",
      "heading": "The page has no canonical URL.",
      "description": "Without <link rel=\"canonical\">, search engines decide which variant of the URL (with or without parameters, http or https, trailing slash) to index.",
      "recommendation": "Add a <link rel=\"canonical\"> pointing to the preferred URL of this page, usually the page itself.",
      "position": null
    },
    {
      "code": "LangMissing",
      "category": "Standards",
      "level": "Warning",
      "heading": "The page doesn't declare its language.",
      "description": "The <html> element has no lang attribute. Screen readers use it to pick a pronunciation, and browsers and search engines use it as a language hint.",
      "recommendation": "Add a lang attribute to the <html> element, e.g. <html lang=\"en\">.",
      "position": {
        "line": 1,
        "column": 1
      }
    },
    {
      "code": "ViewportMissing",
      "category": "SEO",
      "level": "Warning",
      "heading": "The page has no viewport meta tag.",
      "description": "Without <meta name=\"viewport\">, phones render the page at desktop width and shrink it. Google indexes the mobile version of pages.",
      "recommendation": "Add <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">.",
      "position": null
    }
